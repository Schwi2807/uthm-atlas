{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schwi2807.github.io/uthm-atlas/schema/feature.schema.json",
  "title": "UTHM Atlas surveyed feature",
  "description": "One GeoJSON Feature captured by the Surveyor (or written by hand / imported from OSM). Single source of truth for the Surveyor, the engine and the site checks. Bump x-schema-version on breaking changes.",
  "x-schema-version": 1,
  "type": "object",
  "required": ["type", "id", "geometry", "properties"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "Feature" },
    "id": { "$ref": "#/$defs/uuid" },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "Point" },
        "coordinates": { "$ref": "#/$defs/lonlat" }
      }
    },
    "properties": {
      "type": "object",
      "required": ["campus_id", "kind", "category", "name_en", "source", "last_verified"],
      "additionalProperties": false,
      "properties": {
        "campus_id": { "type": "string", "pattern": "^[a-z0-9-]{2,32}$", "description": "e.g. parit-raja" },
        "kind": { "enum": ["building", "entrance", "poi", "path_note"] },
        "category": { "$ref": "#/$defs/category" },
        "name_en": { "type": "string", "minLength": 1, "maxLength": 120 },
        "name_ms": { "type": ["string", "null"], "maxLength": 120 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 120 }, "uniqueItems": true },
        "code": { "type": ["string", "null"], "maxLength": 24, "description": "Short building/room code, e.g. G3 or FKEE" },
        "parent_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }], "description": "Building this entrance/POI belongs to" },
        "floor": { "type": ["integer", "null"], "minimum": -3, "maximum": 30, "description": "Floor of a POI/room (0 = ground)" },
        "floor_source": { "enum": ["barometer", "manual", null] },
        "floors": { "type": ["integer", "null"], "minimum": 1, "maximum": 30, "description": "Building storey count (for 3D)" },
        "rooms": { "type": "array", "items": { "$ref": "#/$defs/room" } },
        "bearing_deg": { "type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360, "description": "Entrance: direction you face walking IN through the door (true north)" },
        "accessible": { "type": ["boolean", "null"], "description": "Step-free (ramp/lift) access" },
        "capture": { "$ref": "#/$defs/capture" },
        "photos": { "type": "array", "items": { "$ref": "#/$defs/photo" } },
        "notes": { "type": ["string", "null"], "maxLength": 2000 },
        "name_suggestion": {
          "oneOf": [{ "type": "null" }, {
            "type": "object", "additionalProperties": false, "required": ["source", "text"],
            "properties": {
              "source": { "enum": ["osm", "wikidata"] },
              "text": { "type": "string" },
              "distance_m": { "type": "number", "minimum": 0 },
              "ref": { "type": "string" }
            }
          }],
          "description": "The suggestion chip the surveyor started from (advisory; final name is always typed/confirmed)"
        },
        "source": { "enum": ["survey", "osm", "manual"], "description": "survey = walked + captured; osm = draft from OSM, not walked yet" },
        "verified": { "type": "boolean", "description": "true only for walked/confirmed features" },
        "last_verified": { "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "entrance" } } }, "then": { "required": ["bearing_deg"] } },
        { "if": { "properties": { "source": { "const": "survey" } } }, "then": { "required": ["capture"] } }
      ]
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "lonlat": {
      "type": "array", "minItems": 2, "maxItems": 3,
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number" }
      ]
    },
    "category": {
      "enum": [
        "faculty", "lecture_hall", "admin", "library", "hall", "sports", "residential", "clinic", "mosque", "building_other",
        "entrance",
        "cafe", "surau", "atm", "printing", "bus_stop", "parking", "toilet", "kolej_block", "lecture_room", "lab",
        "shop", "office", "landmark", "ramp", "lift", "poi_other",
        "path_note"
      ]
    },
    "room": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "code": { "type": ["string", "null"], "maxLength": 24 },
        "floor": { "type": ["integer", "null"], "minimum": -3, "maximum": 30 },
        "kind": { "enum": ["lecture_room", "lab", "office", "toilet", "surau", "other"] }
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "n", "std_m", "best_acc_m", "started_at"],
      "properties": {
        "method": { "enum": ["averaged", "single", "map_tap"] },
        "n": { "type": "integer", "minimum": 1, "description": "Samples averaged" },
        "std_m": { "type": "number", "minimum": 0, "description": "Horizontal std-dev of the samples (m)" },
        "mean_acc_m": { "type": "number", "minimum": 0 },
        "best_acc_m": { "type": "number", "minimum": 0 },
        "sats_used": { "type": "integer", "minimum": 0 },
        "sats_visible": { "type": "integer", "minimum": 0 },
        "stop_reason": { "enum": ["count", "stable", "manual", null] },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "recaptures": { "type": "integer", "minimum": 0 }
      }
    },
    "photo": {
      "type": "object", "additionalProperties": false, "required": ["file"],
      "properties": {
        "file": { "type": "string", "pattern": "^photos/[A-Za-z0-9._-]+\\.(jpg|jpeg|png|webp)$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "taken_at": { "type": "string", "format": "date-time" },
        "caption": { "type": ["string", "null"], "maxLength": 200 }
      }
    }
  }
}
