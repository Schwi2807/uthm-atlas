{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schwi2807.github.io/uthm-atlas/schema/survey-manifest.schema.json",
  "title": "UTHM Atlas .uthmsurvey manifest",
  "description": "manifest.json at the root of a .uthmsurvey zip. Never contains personal names.",
  "x-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "app_version", "session", "device", "sensors", "files"],
  "properties": {
    "format": { "const": "uthmsurvey" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "app_version": { "type": "string", "maxLength": 32 },
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "campus_id", "started_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "campus_id": { "type": "string", "pattern": "^[a-z0-9-]{2,32}$" },
        "title": { "type": ["string", "null"], "maxLength": 80 },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": ["string", "null"], "format": "date-time" },
        "exported_at": { "type": "string", "format": "date-time" }
      }
    },
    "device": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "android_sdk"],
      "properties": {
        "manufacturer": { "type": "string", "maxLength": 40 },
        "model": { "type": "string", "maxLength": 60 },
        "android_sdk": { "type": "integer", "minimum": 29 },
        "gnss_hardware": { "type": ["string", "null"], "maxLength": 120 }
      }
    },
    "sensors": {
      "type": "object", "additionalProperties": false,
      "required": ["barometer", "compass", "camera", "raw_gnss"],
      "properties": {
        "barometer": { "type": "boolean" },
        "compass": { "type": "boolean" },
        "camera": { "type": "boolean" },
        "raw_gnss": { "type": "boolean" },
        "gnss_status": { "type": "boolean" }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "capture_samples": { "type": "integer", "minimum": 1 },
        "stable_acc_m": { "type": "number" },
        "warn_acc_m": { "type": "number" },
        "floor_height_m": { "type": "number" }
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "features": { "type": "integer", "minimum": 0 },
        "track_points": { "type": "integer", "minimum": 0 },
        "fix_samples": { "type": "integer", "minimum": 0 },
        "photos": { "type": "integer", "minimum": 0 }
      }
    },
    "files": {
      "type": "object", "additionalProperties": false,
      "required": ["features", "track", "fixes"],
      "properties": {
        "features": { "const": "features.geojson" },
        "track": { "const": "track.geojson" },
        "fixes": { "const": "fixes.csv" },
        "raw_gnss": { "type": ["string", "null"] },
        "photos_dir": { "const": "photos/" }
      }
    }
  }
}
